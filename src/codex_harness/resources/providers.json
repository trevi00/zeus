{
  "version": "provider-policy.v1",
  "default_provider": "codex",
  "note": "Git-managed execution policy. The packaged file says what a provider MAY run; host configuration says what is enabled. An assignment message, a task detail or a model output never selects a provider.",
  "providers": {
    "codex": {
      "identity": "codex-app-server",
      "transport": "app_server",
      "model_source": "model_routing",
      "session_resume": "supported",
      "enable_setting": null,
      "controls": {}
    },
    "claude": {
      "identity": "claude-code-cli",
      "transport": "claude_cli",
      "model_source": "explicit_setting",
      "session_resume": "unsupported",
      "enable_setting": "ZEUS_CLAUDE_ASSIGNMENTS",
      "model_setting": "ZEUS_CLAUDE_MODEL",
      "model_pattern": "^(claude-[a-z0-9][a-z0-9._-]*|fable|opus|sonnet|haiku)$",
      "controls": {
        "max_budget_usd": {
          "setting": "ZEUS_CLAUDE_MAX_BUDGET_USD",
          "kind": "number",
          "required": true,
          "minimum": 0.01,
          "maximum": 20
        },
        "timeout_seconds": {
          "setting": "ZEUS_CLAUDE_TIMEOUT_SECONDS",
          "kind": "integer",
          "required": false,
          "minimum": 30,
          "maximum": 3600
        },
        "executable": {
          "setting": "ZEUS_CLAUDE_EXECUTABLE",
          "kind": "path",
          "required": false
        }
      },
      "runtime": {
        "output_format": "stream-json",
        "input_format": "text",
        "verbose": true,
        "partial_messages": false,
        "permission_mode": "acceptEdits",
        "permission_prompts": "none",
        "setting_sources": "",
        "strict_mcp_config": true,
        "restricted": true,
        "restricted_note": "Windows restricted pilot 001 only; Codex review claude-work-017 authorizes one additional call after the two existing calls. Not an operating deployment.",
        "session": "explicit_uuid_per_attempt",
        "tools": [
          "Bash",
          "Read",
          "Edit",
          "Write",
          "Glob",
          "Grep"
        ],
        "allowed_tools": [
          "Read",
          "Edit",
          "Write",
          "Glob",
          "Grep",
          "Bash(python -m pytest *)",
          "Bash(python -m unittest *)",
          "Bash(python -m compileall *)",
          "Bash(git status *)",
          "Bash(git diff *)"
        ],
        "disallowed_tools": [
          "Task",
          "WebFetch",
          "WebSearch",
          "mcp__*"
        ],
        "uncontrolled_inheritance": [
          "managed (administrator) settings still apply",
          "CLAUDE.md discovery in the working directory and home is context, not execution",
          "the host's existing authentication (subscription or API credentials) is used unchanged",
          "skills, custom commands and subagent definitions in the host's home still load; only --bare excludes them and it would require an API key instead of the existing login"
        ],
        "experiment_call_budget": {
          "per_host": 3,
          "total": 3,
          "note": "Pilot 001: preserve the existing two slots and permit exactly one additional Windows call; 300 seconds, USD 1 declared provider limit, no automatic retry. This configuration is not promoted to main."
        }
      }
    }
  },
  "assignments": [
    {
      "provider": "claude",
      "roles": [
        "worker:implementation"
      ],
      "actions": [
        "implement"
      ],
      "workloads": [
        "implementation"
      ],
      "read_only": false
    }
  ]
}
