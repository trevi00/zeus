    {
      "id": 6,
      "type": "timeseries",
      "title": "Unknown invocations by reason (1d increase)",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "description": "Finalized invocations whose token usage is unknown, at most one per invocation, by reason.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "sum by (reason) (increase(zeus_llm_unknown_invocations_total{provider=~\"$provider\"}[1d]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Unknown ratio (1d)",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "description": "Recording rule zeus:llm_unknown_ratio:1d; TokObsUnknownHigh fires above 0.2.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "zeus:llm_unknown_ratio:1d",
