    {
      "id": 2,
      "type": "stat",
      "title": "Exporter up",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "description": "Prometheus scrape of the tokobs collector (DESIGN 5.1). No data is shown as No data, never 0.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "up{job=\"tokobs\"}",
          "legendFormat": "exporter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scan age",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "description": "Seconds since the last successful scan; TokObsScanStale fires above 300 s.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "time() - zeus_tokobs_last_scan_success_timestamp_seconds",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Render refused",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "description": "1 when the last render was refused (series cap or label check); data.prom is then the last good render.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "zeus_tokobs_render_refused",
          "legendFormat": "refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Refused",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "S9 age",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "description": "Seconds since the S9 monitoring snapshot was collected; TokObsS9SnapshotStale fires above 120 s.",
      "targets": [
        {
          "refId": "A",
