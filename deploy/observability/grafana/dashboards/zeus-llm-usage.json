    {
      "id": 11,
      "type": "timeseries",
      "title": "Tokens by role and type (excluding cache_read)",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "description": "Measured tokens over the selected range; cache_read has its own panel.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          },
          "expr": "sum by (role, token_type) (increase(zeus_llm_tokens_total{provider=~\"$provider\",model=~\"$model\",role=~\"$role\",task_class=~\"$task_class\",token_type!=\"cache_read\"}[$__range]))",
          "legendFormat": "{{role}} {{token_type}}"
