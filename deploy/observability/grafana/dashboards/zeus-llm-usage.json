    {
      "id": 17,
      "type": "row",
      "title": "Provider windows",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Window state five_hour",
      "description": "Reported by the provider; not derived from token counts. 1 current, 2 stale, 3 expired, 4 unavailable; an older valid value is never shown as current.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (slot) (zeus_llm_provider_window_state{provider=\"anthropic\",window=\"five_hour\",state=\"current\"}) * 1 + sum by (slot) (zeus_llm_provider_window_state{provider=\"anthropic\",window=\"five_hour\",state=\"stale\"}) * 2 + sum by (slot) (zeus_llm_provider_window_state{provider=\"anthropic\",window=\"five_hour\",state=\"expired\"}) * 3 + sum by (slot) (zeus_llm_provider_window_state{provider=\"anthropic\",window=\"five_hour\",state=\"unavailable\"}) * 4",
          "legendFormat": "{{slot}}",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          }
        },
        {
          "refId": "B",
          "expr": "max by (slot) (zeus_llm_provider_window_observed_timestamp_seconds{provider=\"anthropic\",window=\"five_hour\"}) * 1000",
          "legendFormat": "{{slot}} last observed",
          "datasource": {
            "type": "prometheus",
            "uid": "tokobs-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Current",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "Stale",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Expired",
                  "color": "#9fa7b3",
                  "index": 2
                },
                "4": {
                  "text": "Unavailable: newest observation has no valid reading for this window",
                  "color": "#5c6370",
                  "index": 3
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      }
    },
