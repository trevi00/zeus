      "title": "Advisor consultations per accepted task (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
