      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "description": "Always visible and never folded into named roles: roles nested_unattributed and advisor_or_nested, task classes unattributed_interval and identity_unavailable. Not filtered by the dashboard variables.",
      "targets": [
