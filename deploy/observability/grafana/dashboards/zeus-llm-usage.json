{
  "uid": "zeus-llm-usage",
  "title": "zeus-llm-usage",
  "description": "LLM token usage and task efficiency (DESIGN 6). Estimated cost is a client estimate, not a charge.",
  "schemaVersion": 39,
  "editable": false,
  "tags": [
    "zeus",
    "tokobs"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tokobs-prom"
        },
        "definition": "label_values(zeus_llm_tokens_total, provider)",
        "query": {
          "qryType": 1,
          "query": "label_values(zeus_llm_tokens_total, provider)",
          "refId": "tokobs-provider"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "role",
        "label": "role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tokobs-prom"
        },
        "definition": "label_values(zeus_llm_tokens_total, role)",
        "query": {
          "qryType": 1,
          "query": "label_values(zeus_llm_tokens_total, role)",
          "refId": "tokobs-role"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "model",
        "label": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tokobs-prom"
        },
        "definition": "label_values(zeus_llm_tokens_total, model)",
        "query": {
          "qryType": 1,
          "query": "label_values(zeus_llm_tokens_total, model)",
          "refId": "tokobs-model"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "task_class",
        "label": "task_class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tokobs-prom"
        },
        "definition": "label_values(zeus_llm_tokens_total, task_class)",
        "query": {
          "qryType": 1,
          "query": "label_values(zeus_llm_tokens_total, task_class)",
          "refId": "tokobs-task_class"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Data quality",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "tokobs-prom"
      },
      "gridPos": {
        "h": 1,
