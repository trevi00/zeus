# Non-secret host settings for the Zeus aibox services.
# Install as @ZEUS_ROOT@/config/zeus-aibox.env (mode 0640, owner = service UID). No secrets here.
# Addresses are loopback or Docker service names only: a LAN IP change must not touch this file.
ZEUS_REDIS_NAMESPACE=zeus
# Monitor scope; see codex_harness.adapters.monitoring.container_scope.
# ZEUS_MONITOR_SCOPE=
# ZEUS_MONITOR_CONTAINERS=
# Host delivery stays disabled unless the owner opts in (absent = disabled).
# ZEUS_HOST_DELIVERY_ENABLED=
#
# Secret settings go ONLY in @ZEUS_ROOT@/secrets/zeus-aibox.env (mode 0600, owner = service UID,
# outside Git and artifacts). Names only, never values, are listed here:
#   HARNESS_DATABASE_URL   postgresql://...@127.0.0.1:<zeus-aibox port>/zeus_aibox
#   HARNESS_REDIS_URL      redis://127.0.0.1:<zeus-aibox port>/0
#   CLAUDE_CODE_OAUTH_TOKEN  from `claude setup-token` for the service UID (existing adapter
#                            allowlist); ANTHROPIC_API_KEY must NOT be set alongside it.
