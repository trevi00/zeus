# REBUILD-DESIGN-v2 §5.3 S3 target worker image, built from the TARGET tree with the repository root as
# the build context (`docker build -f Dockerfile.worker .`). Same pins, digest checks, user,
# layout and entry module path as SOURCE M7 `Dockerfile.worker`; only the Python package source
# differs (target/pyproject.toml, target/uv.lock, target/src). The entry module
# `codex_harness.adapters.isolated_worker_entry` is a permanent entry shim that lands with S10 (design
# §3.5); until then this image is declared, not buildable into a working worker (evidence/rebuild/s3/
# pending.json). The pinned CLIs are the S3 contract checked by tests/ported/test_role_containers.py.
#
# INV-ISOLATED-WORKER-001: the fixed worker/verifier image. Built by the owner; referenced only by
# its immutable id (ZEUS_WORKER_IMAGE=sha256:<64hex>). No credential, ~/.claude, personal agent,
# command or MCP asset is copied in; the token arrives at run time by environment name only.
FROM node:22-bookworm-slim AS claude
RUN npm install -g @anthropic-ai/claude-code@2.1.280

# INV-ROLE-CONTAINER-001 (D2): the pinned Codex CLI for codex-role-ro/codex-impl-rw. npm resolves the
# platform package (@openai/codex-linux-x64, an npm alias of @openai/codex@0.156.1-linux-x64); only its
# static musl `codex` binary is copied into the final image, where the build checks its digest.
FROM node:22-bookworm-slim AS codex
RUN npm install -g @openai/codex@0.156.1

# operating-portfolio-001: the monitor frontend's locked dependencies, installed ONCE here by the
# owner's build from the tracked package.json/package-lock.json (npm ci: lock-based clean install
# that refuses a package/lock mismatch, docs.npmjs.com/cli/v11/commands/npm-ci, read 2026-09-20).
# No install, no script and no network ever happens in a worker or verifier run.
FROM node:22-bookworm-slim AS monitor
WORKDIR /opt/zeus-monitor
COPY frontend/monitor/package.json frontend/monitor/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.12.2
COPY --from=claude /usr/local/bin/node /usr/local/bin/node
COPY --from=claude /usr/local/lib/node_modules /usr/local/lib/node_modules
# The link targets the executable the installed package itself declares (package.json bin.claude;
# measured for 2.1.280: bin/claude.exe, there is no cli.js). The build fails unless that exact
# pinned CLI answers --version.
RUN python -c "import json, os; root = '/usr/local/lib/node_modules/@anthropic-ai/claude-code'; os.symlink(os.path.join(root, json.load(open(root + '/package.json'))['bin']['claude']), '/usr/local/bin/claude')" \
    && claude --version \
    && claude --version | grep -F "2.1.280"
# The digest check hook: the build fails unless the copied binary is exactly the pinned 0.156.1 linux-x64
# musl build (role_containers.CODEX_CLI_SHA256) and answers its version. No credential, CODEX_HOME or
# ~/.codex is copied in; each run's broker supplies a per-run home.
ARG CODEX_CLI_VERSION=0.156.1
ARG CODEX_CLI_SHA256=0b2e9301d6100dddda3b9d5c80ebaeaa3a2f1962388f2f36f6b96a9f08b1f33f
COPY --from=codex /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex /opt/codex/bin/codex
RUN echo "${CODEX_CLI_SHA256}  /opt/codex/bin/codex" | sha256sum -c - \
    && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
    && codex --version | grep -Fx "codex-cli ${CODEX_CLI_VERSION}"
# The frozen monitor toolchain: the store the checks bind, plus the package/lock bytes they compare
# the candidate's against. Read-only at run time; the build fails if an entrypoint is missing.
COPY --from=monitor /opt/zeus-monitor /opt/zeus-monitor
RUN test -f /opt/zeus-monitor/package.json && test -f /opt/zeus-monitor/package-lock.json \
    && test -f /opt/zeus-monitor/node_modules/eslint/bin/eslint.js \
    && test -f /opt/zeus-monitor/node_modules/typescript/bin/tsc \
    && test -f /opt/zeus-monitor/node_modules/vite/bin/vite.js \
    && /usr/local/bin/node /opt/zeus-monitor/node_modules/typescript/bin/tsc --version
# Trusted package, locked dependencies, pytest and ruff live in /opt/zeus, installed non-editable so
# nothing under /workspace can shadow the entrypoint or the pinned profile hook.
WORKDIR /build
COPY pyproject.toml uv.lock ./
COPY src ./src
ENV UV_PROJECT_ENVIRONMENT=/opt/zeus
# The venv interpreter is a COPY, never a symlink: the worker profile resolves its interpreter
# (Path.resolve) and puts that directory first on PATH, and a symlinked venv python resolves out to
# /usr/local/bin, where neither pytest nor ruff exists (measured). uv sync reuses this venv; the
# build fails if it was replaced by a symlinked one.
RUN python -m venv --copies --without-pip /opt/zeus \
    && uv sync --frozen --no-editable && rm -rf /build /root/.cache \
    && test ! -L /opt/zeus/bin/python \
    && test "$(/opt/zeus/bin/python -I -c 'import os, sys; print(os.path.realpath(sys.executable))')" = /opt/zeus/bin/python
RUN useradd --uid 10001 --create-home --home-dir /home/worker worker && mkdir -p /workspace /evidence
ENV PATH="/opt/zeus/bin:$PATH" \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /
# Again as the unprivileged runtime user, through PATH, exactly as the inner runtime resolves it.
RUN claude --version | grep -F "2.1.280" && codex --version | grep -Fx "codex-cli ${CODEX_CLI_VERSION}"
# The worker profile's interpreter selection (context.adapters.worker_profile, moved in S2), the environment it
# derives from the Claude CLI transport's allow-listed child environment (execution.adapters.providers.claude_cli,
# moved in S4), `python` found through that PATH, then the profile-selected pytest and ruff under exactly that
# environment: the M7 check, restored. No credential, no network and no model call is involved.
RUN /opt/zeus/bin/python -I -c "import shutil, subprocess; from pathlib import Path; from codex_harness.execution.adapters.providers.claude_cli import child_environment; from codex_harness.context.adapters.worker_profile import profile_environment, verified_interpreter; interpreter = verified_interpreter(); assert interpreter.parent == Path('/opt/zeus/bin'), interpreter; env = profile_environment(child_environment()[0], '/workspace', interpreter)[0]; python = shutil.which('python', path=env['PATH']); assert python is not None and Path(python).resolve().parent == Path('/opt/zeus/bin'), python; [subprocess.run([python, '-m', tool, '--version'], env=env, cwd='/workspace', check=True) for tool in ('pytest', 'ruff')]"
ENTRYPOINT ["/opt/zeus/bin/python", "-I", "-m", "codex_harness.adapters.isolated_worker_entry"]
