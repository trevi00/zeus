# Periodic read-only lifecycle inspection on aibox; it needs no Windows observer.
[Unit]
Description=Zeus aibox lifecycle inspection every 5 minutes
Documentation=file://@ZEUS_ROOT@/deploy/aibox/README.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
